# Copy to .env.local (gitignored) and fill in what you need. Everything is
# optional: without a token, wrangler uses its own OAuth login
# (`pnpm dlx wrangler login`).

# Cloudflare API token with "Account > Cloudflare Pages > Edit" permission
# (dashboard: My Profile > API Tokens)
#CLOUDFLARE_API_TOKEN=

# Cloudflare account ID (dashboard: any domain's Overview page, right sidebar)
#CLOUDFLARE_ACCOUNT_ID=

# Pages project name to deploy to (default: zcode-acp-remote)
#CF_PAGES_PROJECT=
